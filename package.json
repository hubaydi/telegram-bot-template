{
  "name": "telegram-bot-template",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "description": "Telegram bot starter template",
  "author": "deptyped <deptyped@gmail.com>",
  "license": "MIT",
  "imports": {
    "#root/*": "./build/src/*"
  },
  "engines": {
    "node": ">=20.0.0",
  },
  "scripts": {
    "lint": "eslint .",
    "format": "eslint . --fix",
    "typecheck": "tsc",
    "build": "tsc --noEmit false",
    "dev": "tsc-watch --onSuccess \"tsx ./src/main.ts\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "start": "tsc && tsx ./src/main.ts",
    "start:force": "tsx ./src/main.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@grammyjs/auto-chat-action": "0.1.1",
    "@grammyjs/commands": "1.4.0",
    "@grammyjs/hydrate": "1.7.0",
    "@grammyjs/i18n": "1.1.2",
    "@grammyjs/runner": "2.0.3",
    "@grammyjs/types": "5.0.0",
    "@hono/node-server": "2.1.1",
    "callback-data": "1.1.1",
    "grammy": "1.46.0",
    "hono": "4.13.7",
    "iso-639-1": "3.1.6",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "tsc-watch": "^7.2.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.ts": "eslint"
  }
}
